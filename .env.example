# ===========================================
# smlnesservice — Configuration Example
# ===========================================
# Copy this file to .env and update values

# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL Connection ----
# 1 instance ของ service ต่อ 1 ลูกค้า (deployment model A)
DB_HOST=customer-pg-host.example.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME_PREFIX=smlerpmain

# ---- PostgreSQL SSL ----
# เปิดเมื่อ PG อยู่คนละ network/host (แนะนำ true ใน production)
DB_SSL=false
# ตั้ง false เฉพาะตอน dev ถ้า cert เป็น self-signed
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Auth ----
# Required ใน production — ใช้ค่า random ยาว >= 32 chars
# ใช้กับ pre-select JWT เท่านั้น (session ใช้ sml_guid ใน DB)
JWT_SECRET=replace-with-a-long-random-secret

# pre-select JWT TTL — ออกจาก /auth/login, ใช้ผ่าน /auth/select-database เท่านั้น
PRE_SELECT_EXPIRES_IN=2m

# Session TTL — sliding (reset ทุก request) นับจาก sml_guid.last_access_time
# Lazy cleanup: guard เจอ row เกิน TTL → DELETE ทิ้ง + คืน 401
SESSION_TTL_HOURS=8
