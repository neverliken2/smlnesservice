# ===========================================
# smlnesservice — Configuration Example
# ===========================================
# Copy this file to .env and update values

# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL Connection ----
# 1 instance ของ service ต่อ 1 ลูกค้า (deployment model A)
DB_HOST=customer-pg-host.example.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME_PREFIX=smlerpmain

# ---- PostgreSQL SSL ----
# เปิดเมื่อ PG อยู่คนละ network/host (แนะนำ true ใน production)
DB_SSL=false
# ตั้ง false เฉพาะตอน dev ถ้า cert เป็น self-signed
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Auth: JWT ----
# Required ใน production — random ยาว >= 32 chars (ใช้ HS256)
JWT_SECRET=replace-with-a-long-random-secret

# Pre-select JWT TTL — ออกหลัง /auth/login ใช้ผ่าน /auth/select-database
PRE_SELECT_EXPIRES_IN=2m

# Session JWT TTL — ใช้ผ่าน Authorization Bearer ทุก endpoint หลัง select-database
SESSION_EXPIRES_IN=8h

# ---- Auth: Allowed clients ----
# JSON array ของ client ที่อนุญาตให้เรียก /auth/login
# Format: [{"clientCode":"<code>","tokenHash":"<bcrypt-hash>"}]
#
# Generate + self-test (รันใน container เดียวกับที่จะ verify):
#   docker exec smlnesservice node -e "const c=require('crypto'),b=require('bcrypt'); \
#     const r=c.randomBytes(32).toString('hex'); const h=b.hashSync(r,12); \
#     console.log('RAW='+r); console.log('HASH='+h); console.log('SELF_TEST='+b.compareSync(r,h));"
# → SELF_TEST=true ต้องเห็น ก่อนนำ HASH มาใส่ที่นี่
#
# เก็บ RAW ที่ client (เช่น .env ของ NextStep CN Coupon) — ส่งใน Authorization Bearer
#
# ⚠️ PRODUCTION (docker compose): ต้อง escape $ → $$ ทุกตัว ใน bcrypt hash
#    เช่น HASH = $2b$12$eHL6l... ใน .env ต้องเป็น $$2b$$12$$eHL6l...
#    ไม่งั้น docker compose ตีความ $Xx เป็น variable interpolation → hash ขาด → INVALID_API_KEY
ALLOWED_CLIENTS_JSON=[{"clientCode":"nextstep-cn-coupon","tokenHash":"$2b$12$replace-with-real-hash"}]
