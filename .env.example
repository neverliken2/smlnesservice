# ===========================================
# smlnesservice — Configuration Example
# ===========================================
# Copy this file to .env and update values

# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL Connection ----
# 1 instance ของ service ต่อ 1 ลูกค้า (deployment model A)
DB_HOST=customer-pg-host.example.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME_PREFIX=smlerpmain

# ---- PostgreSQL SSL ----
# เปิดเมื่อ PG อยู่คนละ network/host (แนะนำ true ใน production)
DB_SSL=false
# ตั้ง false เฉพาะตอน dev ถ้า cert เป็น self-signed
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Auth ----
# Required ใน production — ใช้ค่า random ยาว >= 32 chars
JWT_SECRET=replace-with-a-long-random-secret
# session token TTL — ใช้ใน Authorization Bearer ทุก endpoint หลัง select-database
JWT_EXPIRES_IN=30m
# pre-select token TTL — ออกหลัง /auth/login, ใช้ผ่าน /auth/select-database เท่านั้น
PRE_SELECT_EXPIRES_IN=2m

# ---- Service-to-service API Key ----
# Client (web/mobile) ส่ง X-API-Key + X-Provider ใน header ทุก request
# Hash เก็บที่ smlerpmain<provider>.sml_api_clients (ตาราง — รัน db/migrations/001 ก่อน)
# Generate key + hash ด้วย: npm run gen:apikey
API_KEY_SALT_ROUNDS=12
